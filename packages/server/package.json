{
  "name": "@ai-dev-team/server",
  "version": "0.1.0",
  "private": true,
  "description": "API server with A2A and WebSocket endpoints for AI Dev Team",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/*.test.js dist/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "uuid": "^11.0.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/cors": "^2.8.0"
  }
}
