# LLM Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Default LLM Configuration
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent Configuration
MAX_AGENT_ITERATIONS=25
MAX_TOKENS_PER_TASK=100000
AGENT_TIMEOUT_SECONDS=300

# Server
API_HOST=127.0.0.1
API_PORT=8080
API_KEY=your-api-key-here
A2A_PUBLIC_URL=http://127.0.0.1:8080/a2a
CORS_ORIGINS=http://localhost:3000

# Python task bridge. Must be an absolute, dedicated workspace path.
AGENT_WORKSPACE=/workspace
PYTHON_EXECUTABLE=python3

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-dev-team
LOG_LEVEL=INFO

# Memory
SQLITE_DB_PATH=./data/state.db
CHROMA_PERSIST_DIR=./data/chroma

# Guardrails
# Safe library defaults. The HTTP bridge always overrides both values to true
# and has no approval transport; embedded Python callers must supply a callback.
REQUIRE_APPROVAL_FOR_WRITES=true
REQUIRE_APPROVAL_FOR_SHELL=true
MAX_COST_PER_TASK_USD=5.00
